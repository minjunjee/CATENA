{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catena.local/schemas/v8.1/e26_resource_preflight_receipt.schema.json",
  "title": "CATENA E26 target-context resource-preflight receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "scientific_evidence",
    "evidence_tier",
    "claim_ceiling",
    "source_commit",
    "source_inventory",
    "locked_hashes",
    "upstream_receipts",
    "hardware_inventory",
    "candidates",
    "selection",
    "main_test_opened",
    "scientific_e26a_started",
    "scientific_e26b_started",
    "scientific_main_started",
    "canonical_e26_artifact_created",
    "passed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "catena-v8.1"},
    "manifest_type": {"const": "E26_RESOURCE_PREFLIGHT"},
    "scientific_evidence": {"const": false},
    "evidence_tier": {"const": "NON_EVIDENCE_VALIDATION"},
    "claim_ceiling": {"const": "RESOURCE_FEASIBILITY_ONLY"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_inventory": {"type": "object"},
    "locked_hashes": {"type": "object"},
    "upstream_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_manifest", "numerical_audit", "restart_audit"],
      "properties": {
        "backend_manifest": {"$ref": "#/$defs/manifestBinding"},
        "numerical_audit": {"$ref": "#/$defs/receiptBinding"},
        "restart_audit": {"$ref": "#/$defs/receiptBinding"}
      }
    },
    "hardware_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "candidate_config_sha256",
          "model_config_sha256",
          "resource_projections",
          "worker_spec_sha256",
          "worker_receipt_sha256",
          "worker_report_sha256",
          "execution_device",
          "target_gradient_accumulation"
        ]
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "candidate_id",
        "token_budget",
        "context_length",
        "target_global_batch_tokens",
        "selected_microbatch_sequences",
        "accumulation_steps",
        "selection_sha256"
      ]
    },
    "main_test_opened": {"const": false},
    "scientific_e26a_started": {"const": false},
    "scientific_e26b_started": {"const": false},
    "scientific_main_started": {"const": false},
    "canonical_e26_artifact_created": {"const": false},
    "passed": {"const": true},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "manifest_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "receipt_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
