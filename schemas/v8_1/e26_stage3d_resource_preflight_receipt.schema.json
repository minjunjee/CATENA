{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catena://schemas/v8_1/e26_stage3d_resource_preflight_receipt.schema.json",
  "title": "CATENA E26 Stage-3D post-GO resource preflight receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_type", "scientific_evidence", "evidence_tier",
    "claim_ceiling", "run_dir", "disposition", "inputs", "stage3d_receipt",
    "source", "fixed_layouts", "resource_policy",
    "hardware_inventory", "candidates", "selection", "main_test_opened",
    "scientific_e26a_started", "scientific_e26b_started", "scientific_main_started",
    "canonical_e26_artifact_created", "selection_error", "passed", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "catena-e26-stage3d-resource-preflight-v1"},
    "manifest_type": {"const": "E26_STAGE3D_RESOURCE_PREFLIGHT_RECEIPT"},
    "scientific_evidence": {"const": false},
    "evidence_tier": {"const": "NON_EVIDENCE_NUMERICAL_PREFLIGHT"},
    "claim_ceiling": {"const": "RESOURCE_FEASIBILITY_ONLY"},
    "run_dir": {"type": "string", "minLength": 1},
    "disposition": {
      "enum": ["RESOURCE_PREFLIGHT_FEASIBLE", "RESOURCE_PREFLIGHT_INFEASIBLE"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "stage3d_receipt", "tokenizer_manifest", "corpus_manifest"],
      "properties": {
        "config": {"$ref": "#/$defs/fileBinding"},
        "tokenizer_manifest": {"$ref": "#/$defs/fileBinding"},
        "corpus_manifest": {"$ref": "#/$defs/fileBinding"},
        "stage3d_receipt": {
          "allOf": [
            {"$ref": "#/$defs/fileBinding"},
            {
              "type": "object",
              "required": ["receipt_sha256"],
              "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}}
            }
          ]
        }
      }
    },
    "stage3d_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receipt_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "required": ["git_commit", "source_tree_sha256", "source_file_count"]
    },
    "fixed_layouts": {"type": "array", "minItems": 3, "maxItems": 3},
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_budgets", "deadline_reference_hours", "deadline_fraction_max",
        "max_main_wall_clock_hours", "safety_time_multiplier",
        "max_main_checkpoint_storage_gib", "main_runs", "gpu_lanes",
        "save_every_tokens"
      ],
      "properties": {
        "token_budgets": {"const": [250000000, 375000000, 500000000]},
        "deadline_reference_hours": {"const": 240},
        "deadline_fraction_max": {"const": 0.70},
        "max_main_wall_clock_hours": {"const": 168},
        "safety_time_multiplier": {"const": 1.25},
        "max_main_checkpoint_storage_gib": {"const": 100},
        "main_runs": {"const": 10},
        "gpu_lanes": {"const": 4},
        "save_every_tokens": {"const": 25000000}
      }
    },
    "hardware_inventory": {"type": "array", "minItems": 1},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "candidate_config_sha256", "fixed_layout", "measurement",
          "resource_projections", "paired_recipe_identity", "execution_device",
          "worker_run_dir", "worker_report_sha256", "worker_receipt_sha256"
          , "worker_report", "worker_receipt"
        ],
        "properties": {
          "candidate_id": {
            "enum": ["d512_ctx4096", "d512_ctx2048", "d448_ctx4096"]
          },
          "candidate_config_sha256": {"$ref": "#/$defs/sha256"},
          "fixed_layout": {"type": "object"},
          "measurement": {"type": "object"},
          "resource_projections": {"type": "array", "minItems": 3},
          "paired_recipe_identity": {"type": "object"},
          "execution_device": {"type": "object"},
          "worker_run_dir": {"type": "string", "minLength": 1},
          "worker_report_sha256": {"$ref": "#/$defs/sha256"},
          "worker_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "worker_report": {"$ref": "#/$defs/fileBinding"},
          "worker_receipt": {
            "allOf": [
              {"$ref": "#/$defs/fileBinding"},
              {
                "type": "object",
                "required": ["receipt_sha256"],
                "properties": {"receipt_sha256": {"$ref": "#/$defs/sha256"}}
              }
            ]
          }
        }
      }
    },
    "selection": {"type": ["object", "null"]},
    "selection_error": {"type": ["string", "null"]},
    "main_test_opened": {"const": false},
    "scientific_e26a_started": {"const": false},
    "scientific_e26b_started": {"const": false},
    "scientific_main_started": {"const": false},
    "canonical_e26_artifact_created": {"const": false},
    "passed": {"type": "boolean"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}},
      "then": {
        "properties": {
          "disposition": {"const": "RESOURCE_PREFLIGHT_FEASIBLE"},
          "selection": {"type": "object"},
          "selection_error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "disposition": {"const": "RESOURCE_PREFLIGHT_INFEASIBLE"},
          "selection": {"type": "null"},
          "selection_error": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
