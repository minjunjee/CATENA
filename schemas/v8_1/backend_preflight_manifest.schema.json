{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catena.local/schemas/v8.1/backend_preflight_manifest.schema.json",
  "title": "CATENA E26 post-audit backend promotion manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "manifest_type",
    "scientific_evidence",
    "main_test_opened",
    "source_commit",
    "source_inventory",
    "candidate_lock",
    "numerical_audit",
    "restart_audit",
    "torch_version",
    "cuda_version",
    "hardware_inventory",
    "candidate_audits",
    "fallback_count",
    "graph_break_count",
    "candidate_codegen_capable",
    "e26a_candidate_capable",
    "e26a_gate_capable",
    "scientific_main_capable",
    "parity_verified",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "catena-v8.1"},
    "manifest_type": {"const": "E26_BACKEND_PREFLIGHT_MANIFEST"},
    "scientific_evidence": {"const": false},
    "main_test_opened": {"const": false},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "fallback_count": {"type": "integer", "minimum": 0},
    "graph_break_count": {"type": "integer", "minimum": 0},
    "candidate_codegen_capable": {"const": true},
    "hardware_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "physical_device_index",
          "name",
          "total_memory_bytes",
          "compute_capability",
          "driver_version",
          "gpu_uuid"
        ]
      }
    },
    "e26a_candidate_capable": {"type": "boolean"},
    "e26a_gate_capable": {"const": false},
    "scientific_main_capable": {"const": false},
    "parity_verified": {"const": false},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
