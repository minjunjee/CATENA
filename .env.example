# Put caches on local NVMe rather than a network-mounted home directory.
CATENA_DATA_ROOT=/data/catena
HF_HOME=/data/catena/hf
TRANSFORMERS_CACHE=/data/catena/hf/transformers
HF_DATASETS_CACHE=/data/catena/hf/datasets
TORCH_EXTENSIONS_DIR=/data/catena/torch_extensions

# PyTorch allocator and tokenizer behavior.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false

# Model paths. The RWKV pip backend expects a local .pth checkpoint path without extension.
CATENA_RWKV_PTH=
CATENA_RWKV_HF=fla-hub/rwkv7-2.9B-g1
CATENA_TRANSFORMER_HF=Qwen/Qwen2.5-3B-Instruct
